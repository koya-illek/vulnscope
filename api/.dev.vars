# Local-development overrides for `wrangler dev`. These values shadow
# wrangler.toml [vars] only in local dev; production never sees them.
#
# `wrangler dev` emulates the scan.illek.ie custom-domain host over plain
# HTTP and rewrites both the request URL and the Origin header to that host,
# so:
#   1. The unconditional HTTP→HTTPS entry redirect (see index.ts) would
#      308-loop every local request. ENVIRONMENT="development" disables it.
#   2. A browser page served from http://localhost:8788 presents an Origin of
#      http://scan.illek.ie by the time the Worker sees it, so the dev CORS
#      allowlist must contain the emulated origin, not localhost.
ENVIRONMENT="development"
ALLOWED_ORIGINS="http://scan.illek.ie,https://scan.illek.ie,http://localhost:8788"
# Fixed local-only value. Production must use a separately generated secret
# through `wrangler secret put RATE_LIMIT_HMAC_KEY`.
RATE_LIMIT_HMAC_KEY="local-development-only-quota-hmac-key"
