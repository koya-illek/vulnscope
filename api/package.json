{
  "name": "vuln-scanner-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run check:web",
    "check:web": "node --check ../web/app.js && node --check ../web/report-view.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "smoke:production": "node scripts/production-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "tldts": "^7.4.9"
  }
}
