{
  "name": "vuln-scanner-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run check:web && npm run check:openapi",
    "check:openapi": "redocly lint ../web/openapi.yaml ../web/mcp-copilot.yaml",
    "check:web": "node --check ../web/app.js && node --check ../web/report-view.js && node --check ../web/stream-reader.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "verify:release": "npm run check && npm audit --audit-level=low && wrangler deploy --dry-run --outdir ../dist/wrangler-dry-run",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:production:scan": "node scripts/production-scan-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@redocly/cli": "^2.47.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "tldts": "^7.4.9"
  }
}
